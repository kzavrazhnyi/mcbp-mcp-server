# /etc/mcbp-mcp/<instance>.env — chmod 600, owned by root. Never commit the filled-in copy.
#
# One file per BAS base; the file name is the systemd instance name (mcbp-mcp@prod ->
# /etc/mcbp-mcp/prod.env). Copy this template once per base and change ONEC_BASE_URL,
# the credentials and MCP_HTTP_PORT. Two instances may point at the SAME base with different
# MCP_ALLOW_WRITE — that is how a read-only and a read-write surface are separated.

# --- BAS side: the FALLBACK identity ---
# Over HTTP these credentials are the SERVICE identity, not the only one. A client that sends
# `Authorization: Basic <base64 user:password>` runs every tool call under its OWN BAS account,
# and the account below is used only for requests that carry no such header (and for the startup
# health probe). Over stdio it remains the only identity there is.
# Keep it a low-privilege account: it is what an unauthenticated caller acts as.
# NO trailing /ai/v1: the client appends it itself. Leaving it on gives /ai/v1/ai/v1/... —
# every route 404s while /health keeps answering, so the cause is invisible.
# http:// is accepted and is what the internal bases use today. Note what that costs: BAS
# credentials go out as HTTP Basic on EVERY request — the ones below AND every per-user set a
# client presents — so on a plain-http base they cross the internal network in the clear.
ONEC_BASE_URL=http://bas.internal.example/basename/hs/mcbp_ai
ONEC_USER=ai_service
# Must be PRESENT even when empty — an absent key is a startup error, an empty value is legal.
ONEC_PASSWORD=
# Applies to https base URLs only; ignored for http. Leave at 1: the bases carry ordinary
# domain certificates, so verification needs nothing installed. Should a base ever move behind
# an internal CA, put that CA root in the system trust store rather than setting this to 0 —
# turning verification off is permanent and silent, a trust-store entry is neither.
ONEC_VERIFY_SSL=1
ONEC_TIMEOUT=30
# Each instance opens up to this many connections to its own base.
ONEC_POOL_MAX=10

# --- tool surface ---
# 0 -> the 10 read tools. Turning this on adds write_object, save_context, patch_object.
# This is a per-process setting, so it is also a per-instance one: a client connected to a
# read-only instance does not see the write tools at all.
MCP_ALLOW_WRITE=0

# --- HTTP transport ---
# Stage 1 (internal network, no nginx): bind the LAN interface so clients reach the process
# directly. 0.0.0.0 listens on every interface; a fixed LAN address is narrower and preferable
# when the box has more than one.
# Stage 2 (public IP, nginx in front): set this back to 127.0.0.1 — the process must then be
# reachable only through the proxy.
MCP_HTTP_HOST=0.0.0.0
# DISTINCT per instance — two processes cannot share a port. Example allocation:
#   prod 8011, demo 8012, buh 8013 ... and a read-write twin at +10 (prod-rw 8021).
MCP_HTTP_PORT=8011
# The path this process answers on. Leave it at /mcp: with nginx (stage 2) the base is selected
# by the nginx location, which proxies to this instance's port, so the internal path stays the
# same everywhere.
MCP_HTTP_PATH=/mcp
# The hostname clients put in the URL. Setting it turns on DNS-rebinding protection; leaving it
# empty leaves that protection off (an empty allow-list would reject every request with 421).
# Stage 1: leave EMPTY — clients dial an IP or an internal name, and there is no proxy to
# normalise the Host header, so a wrong entry here fails every request with 421.
# Stage 2: set it to the public hostname.
MCP_HTTP_ALLOWED_HOSTS=
MCP_HTTP_SESSION_IDLE_TIMEOUT=1800

# --- Caller authentication ---
# Token registry: a TOML file mapping an opaque bearer token to a BAS account. Needed by clients
# that can only send `Authorization: Bearer <token>` (Codex) rather than an arbitrary header.
#
#   [[users]]
#   token = "<random string>"
#   onec_user = "Директор-Корнієнко"
#   onec_password = ""
#   label = "Директор"        # optional, logs only
#
# Empty -> Bearer is not accepted at all. Set but missing/malformed -> the server refuses to
# start (a silent start with Bearer disabled would look exactly like a working server). The file
# holds passwords: keep it readable only by the service user.
MCP_TOKENS_FILE=

# 1 -> a request with NO Authorization header is rejected (400 BAD_AUTHORIZATION) instead of
# running under ONEC_USER above. Turn it on for any port reachable beyond loopback.
MCP_REQUIRE_AUTH=0
