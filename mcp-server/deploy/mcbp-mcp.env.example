# /etc/mcbp-mcp.env — chmod 600, owned by root. Never commit the filled-in copy.

# --- BAS side ---
# NO trailing /ai/v1: the client appends it itself. Leaving it on gives /ai/v1/ai/v1/... —
# every route 404s while /health keeps answering, so the cause is invisible.
ONEC_BASE_URL=https://bas.example.com/basename/hs/mcbp_ai
ONEC_USER=ai_service
# Must be PRESENT even when empty — an absent key is a startup error, an empty value is legal.
ONEC_PASSWORD=
# Keep at 1. If the BAS certificate is internal, install its CA root into the system trust
# store rather than turning verification off.
ONEC_VERIFY_SSL=1
ONEC_TIMEOUT=30
ONEC_POOL_MAX=10

# --- tool surface ---
# 0 -> the 10 read tools. Turning this on adds write_object, save_context, patch_object.
MCP_ALLOW_WRITE=0

# --- HTTP transport ---
# Loopback only: nginx terminates TLS and is the sole way in.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8010
MCP_HTTP_PATH=/mcp
# The public hostname clients use. Setting it turns on DNS-rebinding protection; leaving it
# empty leaves that protection off (an empty allow-list would reject every request with 421).
MCP_HTTP_ALLOWED_HOSTS=mcp.example.com
MCP_HTTP_SESSION_IDLE_TIMEOUT=1800
