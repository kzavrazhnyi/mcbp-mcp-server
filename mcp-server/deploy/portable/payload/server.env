# server.env — конфігурація портабельної поставки MCP-сервера mcbp-ai.
#
# Формат: KEY=VALUE, кодування UTF-8. Порожні рядки і рядки з '#' на початку — коментарі.
# Значення може бути ПОРОЖНІМ (саме так задається порожній пароль демо-бази).
# Пробіли навколо ключа й значення обрізаються; щоб зберегти їх у значенні — візьміть
# значення в лапки: ONEC_PASSWORD=" пароль з пробілом "
#
# Файл читає serve.py і кладе значення в оточення процесу. НЕ комітьте заповнену копію
# з реальним паролем.

# --- Підключення до BAS ---
# Базова адреса HTTP-сервісу MCBP_AI. БЕЗ хвостового /ai/v1 — клієнт додає його сам.
# Якщо лишити /ai/v1, вийде /ai/v1/ai/v1/... : усі маршрути дадуть 404, а /health і далі
# відповідатиме, тому причина буде невидима.
ONEC_BASE_URL=http://localhost/basmbdemo/hs/mcbp_ai

# Обліковка BAS, під якою працює сервер, якщо запит НЕ несе заголовка Authorization.
# Якщо клієнт надішле `Authorization: Basic <base64 користувач:пароль>`, кожен виклик
# інструмента піде під ЙОГО обліковкою, а ця буде використана лише для решти запитів.
# Тримайте тут обліковку з мінімальними правами.
ONEC_USER=Адміністратор

# Ключ має бути ПРИСУТНІЙ навіть із порожнім значенням — відсутній ключ це помилка старту.
ONEC_PASSWORD=

# Стосується лише https-адрес бази; для http ігнорується.
ONEC_VERIFY_SSL=1
ONEC_TIMEOUT=30
ONEC_POOL_MAX=10

# --- Набір інструментів ---
# 0 -> 10 інструментів читання. 1 додає write_object, save_context, patch_object.
MCP_ALLOW_WRITE=0

# --- HTTP-транспорт ---
# 127.0.0.1 — сервер доступний лише з цієї машини (безпечний типовий варіант).
# Щоб пустити клієнтів по мережі, поставте 0.0.0.0 або конкретну LAN-адресу — і тоді
# обов'язково увімкніть https нижче: облікові дані BAS ідуть у заголовку Basic відкрито.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8010
MCP_HTTP_PATH=/mcp

# Ім'я хоста, яке клієнти пишуть в URL. Заповнене — вмикає захист від DNS-rebinding.
# Порожнє — захист вимкнено (порожній список відхиляв би КОЖЕН запит з кодом 421).
MCP_HTTP_ALLOWED_HOSTS=
MCP_HTTP_SESSION_IDLE_TIMEOUT=1800

# --- Авторизація клієнтів ---
# Реєстр токенів: файл TOML, кожен запис зіставляє токен з обліковкою BAS. Потрібен
# клієнтам, які вміють лише `Authorization: Bearer <токен>` (Codex), а не Basic.
# Свіжий токен друкує new-token.cmd. Порожній onec_password — легальний.
#
#   [[users]]
#   token = "<випадковий рядок>"
#   onec_user = "Директор-Корнієнко"
#   onec_password = ""
#   label = "Директор"
#
# Порожнє значення -> Bearer не приймається взагалі. Заданий, але відсутній чи битий
# файл -> сервер НЕ стартує (мовчазний старт без Bearer виглядав би як робочий).
# Тримайте файл поза загальним доступом: у ньому паролі.
MCP_TOKENS_FILE=

# 1 -> запит БЕЗ заголовка Authorization відхиляється (400 BAD_AUTHORIZATION) замість
# того, щоб виконатися під обліковкою ONEC_USER вище. Обов'язково вмикайте разом із
# MCP_HTTP_HOST=0.0.0.0, інакше будь-хто в мережі працює як службова обліковка.
MCP_REQUIRE_AUTH=0

# --- HTTPS (необов'язково) ---
# Розкоментуйте ОБИДВА рядки після запуску make-cert.ps1 (потрібні права адміністратора).
# Шляхи можна писати відносно теки поставки.
#MCP_HTTP_SSL_CERTFILE=certs\mcbp-mcp.crt.pem
#MCP_HTTP_SSL_KEYFILE=certs\mcbp-mcp.key.pem
